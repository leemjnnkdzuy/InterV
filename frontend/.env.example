MONGODB_URI=
# Dedicated storage for API logs. Records have a fixed seven-day TTL.
MONGODB_URI_EVENT=
MONGODB_EVENT_DB_NAME=interv-events
API_LOG_SLOW_THRESHOLD_MS=1000
# Generate unique values with: pnpm security:rotate-secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

SMTP_USER=
SMTP_PASS=
# Test/dev only. Production always sends through SMTP even if this is set.
# SMTP_DRY_RUN=true

NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_BACKEND_GRPC_URL=localhost:50051
AI_BACKEND_INTERNAL_KEY=
# Required when AI_BACKEND_GRPC_URL is not loopback.
# PEM text (with \n escapes) or base64-encoded PEM.
# AI_BACKEND_GRPC_TLS_CA_PEM=
# AI_BACKEND_GRPC_TLS_CLIENT_CERT_PEM=
# AI_BACKEND_GRPC_TLS_CLIENT_KEY_PEM=
# AI_BACKEND_GRPC_TLS_SERVER_NAME=ai.internal.example.com

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Used for PayOS return/cancel URLs. Set the deployed HTTPS origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
